{
  "expo": {
    "name": "Finances",
    "slug": "darkfinances",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "darkfinances",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a84f6d6f-e5fb-4851-91e4-0c5278b57cd5",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "buildNumber": "3",
      "bundleIdentifier": "dev.darkmg1.finances",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Unlock DarkFinances with Face ID."
      }
    },
    "android": {
      "package": "dev.darkmg1.finances",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock DarkFinances with Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a receipt photo to a transaction.",
          "cameraPermission": "Scan a receipt to attach it to a transaction."
        }
      ],
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#7c6ef7"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "dev.darkmg1.finances.widget",
          "groupIdentifier": "group.dev.darkmg1.finances",
          "widgets": [
            {
              "name": "FinanceWidget",
              "displayName": "Finances",
              "description": "Net worth and your next bill at a glance.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a84f6d6f-e5fb-4851-91e4-0c5278b57cd5"
      }
    },
    "owner": "darkmg1"
  }
}
