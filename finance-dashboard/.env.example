# Copy to .env and fill in. The dashboard reads these at startup.

# --- Actual Budget server (required) ---
# URL of your self-hosted Actual server.
ACTUAL_SERVER_URL=https://actual.example.com
# The server password used to open the file.
ACTUAL_PASSWORD=your-actual-password
# The budget's Sync ID (Actual: Settings -> Advanced -> Sync ID).
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
# Local cache dir Actual downloads the budget into.
ACTUAL_DATA_DIR=/tmp/actual-dashboard-cache
# Path to the installed @actual-app/api package (only if not resolvable normally).
# ACTUAL_API_PATH=/usr/lib/node_modules/@actual-app/api

# --- API auth for the mobile app (required) ---
# Shared secret the app sends as X-Finance-Token. Generate a long random string.
FINANCE_API_TOKEN=generate-a-long-random-token
# Optional: express session secret (defaults to a random per-boot value).
# SESSION_SECRET=another-long-random-string

# --- Server ---
PORT=5007
# Public origin for browser/passkey flows. For local dev, the default is http://localhost:5007.
# PUBLIC_ORIGIN=https://finances.example.com
# Optional WebAuthn/passkey overrides. Defaults derive from PUBLIC_ORIGIN.
# WEBAUTHN_RP_NAME=DarkFinances
# WEBAUTHN_RP_ID=finances.example.com
# WEBAUTHN_ORIGIN=https://finances.example.com
# PASSKEY_USER_NAME=owner
# PASSKEY_USER_DISPLAY_NAME=Owner

# --- Splitwise (optional; enables Who-Owes-Me from Splitwise groups) ---
# Either a personal API key...
# SPLITWISE_API_KEY=
# ...or OAuth client credentials:
# SPLITWISE_CONSUMER_KEY=
# SPLITWISE_CONSUMER_SECRET=

# --- Optional path overrides (defaults sit next to the code) ---
# PERSONAL_CONFIG_PATH=./personal-config.json
# OWES_CONFIG_PATH=./owes-config.json
# OWES_TRUTH_PATH=./owes-truth.json
# VENMO_TRUTH_PATH=./venmo-truth.json
# EVENTS_PATH=./events.json

# --- Optional classification overrides ---
# These are JavaScript RegExp source strings compiled case-insensitively.
# REIMBURSEMENT_CATEGORY_PATTERN=^reimbursement$
# MONEY_MOVEMENT_CATEGORY_PATTERN=^(transfers?|investments?|credit\\s*card\\s*payments?|cc\\s*payments?)$
# MONEY_MOVEMENT_GROUP_PATTERN=money\\s*movement
# INCOME_GROUP_PATTERN=^income$
# TRANSFER_PAYEE_PATTERN=^transfer\\s*:?\\s*(to|from)\\b|\\btransfer (to|from)\\b
# SETTLE_UP_PAYEE_PATTERN=splitwise|venmo|cash\\s?app|zelle|paypal

# Optional deployment-specific reimbursement cutoffs.
# REIMB_LEDGER_FROM=YYYY-MM-DD
# REIMB_SUGGEST_FROM=YYYY-MM-DD

# Optional Review inbox thresholds.
# REVIEW_LARGE_CHARGE_THRESHOLD=200
# REVIEW_RECEIPT_THRESHOLD=75

# Optional synthetic Splitwise spend ledger names.
# SPLITWISE_ACCOUNT_NAME=Splitwise
# SPLITWISE_CATEGORY_NAME=Splitwise
