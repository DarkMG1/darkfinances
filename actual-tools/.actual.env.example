# Copy to .actual.env (gitignored). Sourced by run.sh before running a tool.
export ACTUAL_SERVER_URL="https://actual.example.com"
export ACTUAL_PASSWORD="your-actual-password"
export ACTUAL_SYNC_ID="00000000-0000-0000-0000-000000000000"
# Scratch dir the tools download the budget into (wiped on each run).
export FIX_DATA_DIR="/tmp/actual-tools-cache"
# Where the Who-Owes-Me snapshot is written (the dashboard reads this path).
export OWES_TRUTH_PATH="/path/to/finance-dashboard/owes-truth.json"
# Optional: events sidecar if it is not in ../finance-dashboard/events.json.
# export EVENTS_PATH="/path/to/finance-dashboard/events.json"
# Optional: Venmo truth sidecar output path.
# export VENMO_TRUTH_PATH="/path/to/finance-dashboard/venmo-truth.json"
