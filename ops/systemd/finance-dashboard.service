[Unit]
Description=Finance Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/finance-dashboard
ExecStart=/usr/bin/node %h/finance-dashboard/server.js
Restart=on-failure
RestartSec=5
# FINANCE_SHUTDOWN_TIMEOUT_MS defaults to 15s; allow graceful drain plus SIGKILL margin.
TimeoutStopSec=25
UMask=0077
Environment=FINANCE_RUNTIME_MODE=production
Environment=NODE_ENV=production
EnvironmentFile=%h/.openclaw/finance-dashboard.env

[Install]
WantedBy=default.target
